# Voice Receptionist — environment variables
# Copy to .env, then load before running Go:
#   source .env          (bash / Git Bash)
#   set -a; . .env; set +a

PORT=8080

# Speaches STT (Docker — see docker-compose.yml)
SPEACHES_URL=http://localhost:8000

# Ollama LLM (native Windows)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

# Kokoro TTS (Python — run scripts/kokoro_server.py)
KOKORO_URL=http://localhost:5000

# Redis (Docker — see docker-compose.yml)
REDIS_ADDR=localhost:6379

# Bot persona — keep it short, no markdown
SYSTEM_PROMPT=You are a helpful, concise voice assistant. Keep responses short and conversational. Never use markdown formatting or bullet points.
